{
  "description": "How the event form reads and writes an RRULE, identically on the web (repeatRule.ts) and in the iOS Calendar app (RepeatRule.swift). 'parse' cases give a stored rule, what the form shows for it (null: left as written), and what saving it unchanged writes; 'build' cases give the form's state and the rule it writes.",
  "parse": [
    { "name": "a plain choice", "rule": "FREQ=DAILY", "allDay": false, "timeZone": "America/Los_Angeles",
      "expected": { "freq": "DAILY", "interval": 1, "byDay": null, "end": { "kind": "never" }, "extra": [] },
      "rebuilt": "FREQ=DAILY" },
    { "name": "every weekday", "rule": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR", "allDay": false, "timeZone": "America/Los_Angeles",
      "expected": { "freq": "WEEKLY", "interval": 1, "byDay": "MO,TU,WE,TH,FR", "end": { "kind": "never" }, "extra": [] },
      "rebuilt": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR" },
    { "name": "Smart Add's form", "rule": "FREQ=WEEKLY;INTERVAL=2;BYDAY=MO,TH;COUNT=4", "allDay": false, "timeZone": "America/Los_Angeles",
      "expected": { "freq": "WEEKLY", "interval": 2, "byDay": "MO,TH", "end": { "kind": "after", "count": 4 }, "extra": [] },
      "rebuilt": "FREQ=WEEKLY;INTERVAL=2;BYDAY=MO,TH;COUNT=4" },
    { "name": "a timed event's UNTIL is the last second of the day in its zone", "rule": "FREQ=DAILY;INTERVAL=3;UNTIL=20270101T075959Z", "allDay": false, "timeZone": "America/Los_Angeles",
      "expected": { "freq": "DAILY", "interval": 3, "byDay": null, "end": { "kind": "on", "date": "2026-12-31" }, "extra": [] },
      "rebuilt": "FREQ=DAILY;INTERVAL=3;UNTIL=20270101T075959Z" },
    { "name": "east of UTC", "rule": "FREQ=WEEKLY;UNTIL=20261231T145959Z", "allDay": false, "timeZone": "Asia/Tokyo",
      "expected": { "freq": "WEEKLY", "interval": 1, "byDay": null, "end": { "kind": "on", "date": "2026-12-31" }, "extra": [] },
      "rebuilt": "FREQ=WEEKLY;UNTIL=20261231T145959Z" },
    { "name": "an all-day event's UNTIL is read as its UTC date", "rule": "FREQ=YEARLY;UNTIL=20301231T235959Z", "allDay": true, "timeZone": "America/Los_Angeles",
      "expected": { "freq": "YEARLY", "interval": 1, "byDay": null, "end": { "kind": "on", "date": "2030-12-31" }, "extra": [] },
      "rebuilt": "FREQ=YEARLY;UNTIL=20301231T235959Z" },
    { "name": "a bare-date UNTIL, which no expander reads, is rewritten as a date-time", "rule": "FREQ=MONTHLY;UNTIL=20261231", "allDay": false, "timeZone": "America/Los_Angeles",
      "expected": { "freq": "MONTHLY", "interval": 1, "byDay": null, "end": { "kind": "on", "date": "2026-12-31" }, "extra": [] },
      "rebuilt": "FREQ=MONTHLY;UNTIL=20270101T075959Z" },
    { "name": "other parts are kept", "rule": "FREQ=MONTHLY;BYMONTHDAY=15;COUNT=6", "allDay": false, "timeZone": "America/Los_Angeles",
      "expected": { "freq": "MONTHLY", "interval": 1, "byDay": null, "end": { "kind": "after", "count": 6 }, "extra": ["BYMONTHDAY=15"] },
      "rebuilt": "FREQ=MONTHLY;BYMONTHDAY=15;COUNT=6" },
    { "name": "INTERVAL=1 is dropped", "rule": "FREQ=DAILY;INTERVAL=1", "allDay": false, "timeZone": "America/Los_Angeles",
      "expected": { "freq": "DAILY", "interval": 1, "byDay": null, "end": { "kind": "never" }, "extra": [] },
      "rebuilt": "FREQ=DAILY" },
    { "name": "case is not significant", "rule": "freq=weekly;byday=mo", "allDay": false, "timeZone": "America/Los_Angeles",
      "expected": { "freq": "WEEKLY", "interval": 1, "byDay": "MO", "end": { "kind": "never" }, "extra": [] },
      "rebuilt": "FREQ=WEEKLY;BYDAY=MO" },
    { "name": "an RRULE: prefix", "rule": "RRULE:FREQ=DAILY", "allDay": false, "timeZone": "America/Los_Angeles", "expected": null },
    { "name": "an unknown FREQ", "rule": "FREQ=HOURLY", "allDay": false, "timeZone": "America/Los_Angeles", "expected": null },
    { "name": "INTERVAL=0", "rule": "FREQ=DAILY;INTERVAL=0", "allDay": false, "timeZone": "America/Los_Angeles", "expected": null },
    { "name": "an unreadable COUNT", "rule": "FREQ=DAILY;COUNT=abc", "allDay": false, "timeZone": "America/Los_Angeles", "expected": null },
    { "name": "both COUNT and UNTIL", "rule": "FREQ=DAILY;COUNT=3;UNTIL=20261231T000000Z", "allDay": false, "timeZone": "America/Los_Angeles", "expected": null },
    { "name": "a part with no value", "rule": "FREQ=DAILY;BOGUS", "allDay": false, "timeZone": "America/Los_Angeles", "expected": null },
    { "name": "empty", "rule": "", "allDay": false, "timeZone": "America/Los_Angeles", "expected": null }
  ],
  "build": [
    { "name": "every 4 weeks, forever", "allDay": false, "timeZone": "America/Los_Angeles",
      "rule": { "freq": "WEEKLY", "interval": 4, "byDay": null, "end": { "kind": "never" }, "extra": [] },
      "expected": "FREQ=WEEKLY;INTERVAL=4" },
    { "name": "every 3 days, 10 times", "allDay": false, "timeZone": "America/Los_Angeles",
      "rule": { "freq": "DAILY", "interval": 3, "byDay": null, "end": { "kind": "after", "count": 10 }, "extra": [] },
      "expected": "FREQ=DAILY;INTERVAL=3;COUNT=10" },
    { "name": "the end of a day that starts in PST and ends in PDT", "allDay": false, "timeZone": "America/Los_Angeles",
      "rule": { "freq": "DAILY", "interval": 1, "byDay": null, "end": { "kind": "on", "date": "2026-03-08" }, "extra": [] },
      "expected": "FREQ=DAILY;UNTIL=20260309T065959Z" },
    { "name": "all day", "allDay": true, "timeZone": "Asia/Tokyo",
      "rule": { "freq": "WEEKLY", "interval": 2, "byDay": "MO,TU,WE,TH,FR", "end": { "kind": "on", "date": "2026-11-30" }, "extra": [] },
      "expected": "FREQ=WEEKLY;INTERVAL=2;BYDAY=MO,TU,WE,TH,FR;UNTIL=20261130T235959Z" },
    { "name": "a half-hour zone", "allDay": false, "timeZone": "Asia/Kolkata",
      "rule": { "freq": "MONTHLY", "interval": 1, "byDay": null, "end": { "kind": "on", "date": "2026-10-15" }, "extra": ["BYMONTHDAY=15"] },
      "expected": "FREQ=MONTHLY;BYMONTHDAY=15;UNTIL=20261015T182959Z" }
  ]
}
