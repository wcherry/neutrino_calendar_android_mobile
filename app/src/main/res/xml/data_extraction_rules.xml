<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the session and the keyring are sealed with an Android Keystore key
     that does not travel, so a restored copy would be unreadable anyway — and the keyring is not
     something a cloud backup should hold. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
